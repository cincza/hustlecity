PORT=4000
APP_NAME=Hustle City API
JWT_SECRET=change-me-before-online-tests
CORS_ORIGIN=http://localhost:8090,http://127.0.0.1:8090,https://twoj-frontend.netlify.app,https://twoj-projekt.onrender.com
DATA_DIR=./data
# Optional: creates the reserved admin or restores a disabled legacy admin.
# Use a unique password: at least 12 characters, at most 72 UTF-8 bytes.
# Leave unset to run without creating an admin account.
# ADMIN_BOOTSTRAP_PASSWORD=
# One-deploy emergency rotation for an existing reserved admin. Set back to 0 immediately.
# ADMIN_BOOTSTRAP_ROTATE_PASSWORD=0

# Optional web checkout. Disabled until all three values are configured.
# Never place these secrets in EXPO_PUBLIC_* variables.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PREMIUM_RETURN_URL=https://your-game.example/
