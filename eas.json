{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://hustle-city-api.onrender.com",
        "EXPO_PUBLIC_MONETIZATION_ENABLED": "0",
        "EXPO_PUBLIC_PUBLIC_WEB_BASE_URL": "https://hustle-city-web.onrender.com"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production"
    },
    "play-test": {
      "extends": "production",
      "channel": "play-test"
    }
  },
  "submit": {
    "play-test": {
      "android": { "track": "internal", "releaseStatus": "draft" }
    }
  }
}
